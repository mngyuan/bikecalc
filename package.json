{
  "name": "bikecalc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node -e \"require('node:fs').copyFileSync('build/client/__spa-fallback.html', 'build/client/404.html')\"",
